{
  "ConnectionStrings": {
    "AntiFraud": ""
  },
  "Features": {
    "UseRabbitMq": true
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "ExchangeName": "antifraud.events",
    "QueueName": "antifraud.transactions",
    "RoutingKey": "transaction.received"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
