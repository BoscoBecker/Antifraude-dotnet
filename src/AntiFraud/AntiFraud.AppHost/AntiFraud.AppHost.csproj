<Project Sdk="Microsoft.NET.Sdk">

  <Sdk Name="Aspire.AppHost.Sdk" Version="13.5.4" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAspireHost>true</IsAspireHost>
    <RootNamespace>AntiFraud.AppHost</RootNamespace>
    <UserSecretsId>antifraud-api-local-dev-8f4e2c1a-5b3d-4e6f-9a0b-1c2d3e4f5a6b</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="13.5.4" />
    <PackageReference Include="Aspire.Hosting.RabbitMQ" Version="13.5.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\AntiFraud.Api\AntiFraud.Api.csproj" />
    <ProjectReference Include="..\src\AntiFraud.Worker\AntiFraud.Worker.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\scripts\ddl.sql" Link="postgres-init\ddl.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
